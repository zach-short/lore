# Copy to .env and fill in. Register a free key at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" works.
TMDB_API_KEY=

# Needed for the app-connected steps: profile→member sync (every command),
# `lore pull` (export zips uploaded through the app), and
# `lore publish` (data.json → site-data bucket for the app to read).
# Supabase project → Settings → API. The service key stays on this machine —
# never in app/.env, which takes the publishable key instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
