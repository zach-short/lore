  "scripts": {
    "start": "bun run sync-data && expo start",
    "android": "bun run sync-data && expo start --android",
    "ios": "bun run sync-data && expo start --ios",
    "web": "bun run sync-data && expo start --web",
    "lint": "expo lint",
    "sync-data": "node ./scripts/sync-data.mjs",
    "export:web": "bun run sync-data && expo export --platform web",
    "deploy:web": "bun run export:web && node ./scripts/prepare-deploy.mjs && vercel deploy --cwd .deploy/movienight --prod --yes",
